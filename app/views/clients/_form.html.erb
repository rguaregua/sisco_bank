<section class="rounded-3xl border border-slate-200/80 bg-white/90 p-5 shadow-lg shadow-slate-300/20 backdrop-blur md:p-6">
  <% if client.errors.any? %>
    <div class="mb-5 rounded-2xl border border-rose-200 bg-rose-50 px-4 py-3 text-rose-800">
      <h3 class="text-sm font-extrabold uppercase tracking-wide">No se pudo guardar el cliente</h3>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
        <% client.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% document_options_by_person = {
    "Natural" => ["Cedula", "Pasaporte"],
    "Juridica" => ["RIF"]
  } %>
  <% selected_person = client.type_of_person.presence || "Natural" %>
  <% available_document_options = document_options_by_person.fetch(selected_person, Client::DOC_TYPES) %>
  <% editing_client = client.persisted? %>

  <%= form_with model: client, local: true do |f| %>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
      <div>
        <%= f.label :type_of_person, "Tipo de persona", class: "text-sm font-semibold text-slate-700" %>
        <%= f.select :type_of_person,
          options_for_select(Client::PERSON_TYPES, client.type_of_person),
          { prompt: "Selecciona" },
          class: "mt-1 w-full rounded-xl border border-slate-300 px-3 py-2 text-sm text-slate-800 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-200 #{editing_client ? 'cursor-not-allowed bg-slate-100' : 'bg-white'}", required: true,
          id: "client_type_of_person",
          disabled: editing_client,
          data: { document_options_by_person: document_options_by_person.to_json } %>
      </div>

      <div>
        <%= f.label :type_of_document, "Tipo de documento", class: "text-sm font-semibold text-slate-700" %>
        <%= f.select :type_of_document,
          options_for_select(available_document_options, client.type_of_document),
          { prompt: "Selecciona" },
          class: "mt-1 w-full rounded-xl border border-slate-300 px-3 py-2 text-sm text-slate-800 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-200 #{editing_client ? 'cursor-not-allowed bg-slate-100' : 'bg-white'}", required: true,
          id: "client_type_of_document",
          disabled: editing_client %>
        <% if editing_client %>
          <p class="mt-1 text-xs text-slate-500">Este campo no se puede modificar despues de crear el cliente.</p>
        <% end %>
      </div>

      <div>
        <%= f.label :document_number, "Numero de documento", class: "text-sm font-semibold text-slate-700" %>
        <%= f.text_field :document_number,
          id: "client_document_number",
          class: "mt-1 w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-200",
          required: true,
          placeholder: "Numero de documento" %>
      </div>

      <div>
        <%= f.label :full_name, "Nombre completo o razón social", class: "text-sm font-semibold text-slate-700" %>
        <%= f.text_field :full_name, class: "mt-1 w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-200", required: true, pattern: "[A-Za-zÁÉÍÓÚáéíóúÑñ ]+", title: "Solo letras y espacios" %>
      </div>

      <div>
        <%= f.label :email, "Correo", class: "text-sm font-semibold text-slate-700" %>
        <%= f.email_field :email, class: "mt-1 w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-200", required: true %>
      </div>

      <div>
        <%= f.label :primary_phone, "Telefono principal", class: "text-sm font-semibold text-slate-700" %>
        <%= f.text_field :primary_phone, class: "mt-1 w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-200", required: true, placeholder: "0XXXXXXXXXX", inputmode: "numeric", minlength: 11, maxlength: 11, pattern: "0[0-9]{10}", title: "Debe tener 11 digitos e iniciar con 0" %>
      </div>

      <div>
        <%= f.label :secondary_phone, "Telefono secundario", class: "text-sm font-semibold text-slate-700" %>
        <%= f.text_field :secondary_phone, class: "mt-1 w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-200", placeholder: "0XXXXXXXXXX", inputmode: "numeric", minlength: 11, maxlength: 11, pattern: "0[0-9]{10}", title: "Debe tener 11 digitos e iniciar con 0" %>
      </div>

      <div>
        <%= f.label :document_issued_at, "Fecha emision", class: "text-sm font-semibold text-slate-700" %>
        <%= f.date_field :document_issued_at, value: @document_issued_at_input, class: "mt-1 w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-200", required: true %>
      </div>

      <div>
        <%= f.label :document_expires_at, "Fecha vencimiento", class: "text-sm font-semibold text-slate-700" %>
        <%= f.date_field :document_expires_at, value: @document_expires_at_input, class: "mt-1 w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-200", required: true %>
      </div>
    </div>

    <% submit_label = client.persisted? ? "Guardar cambios" : "Crear cliente" %>

    <div class="mt-5 flex flex-wrap items-center gap-2">
      <%= f.submit submit_label, class: "inline-flex items-center gap-2 rounded-xl bg-blue-700 px-4 py-2 text-sm font-semibold text-white transition hover:bg-blue-800 focus:outline-none focus:ring-2 focus:ring-blue-400" %>
      <%= link_to "Cancelar", clients_path, class: "inline-flex items-center gap-2 rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-slate-300" %>
    </div>
  <% end %>
</section>

<script>
  (() => {
    const personSelect = document.getElementById("client_type_of_person");
    const documentSelect = document.getElementById("client_type_of_document");
    const documentNumberInput = document.getElementById("client_document_number");
    if (!personSelect || !documentSelect || !documentNumberInput) return;

    let optionsByPerson = {};

    try {
      optionsByPerson = JSON.parse(personSelect.dataset.documentOptionsByPerson || "{}");
    } catch (_error) {
      optionsByPerson = {};
    }

    const rifLetters = ["J", "G", "V", "E", "P"];
    const cedulaLetters = ["V", "E"];

    const applyRifMask = (rawValue) => {
      const sanitized = String(rawValue || "").toUpperCase().replace(/[^A-Z0-9]/g, "");
      if (!sanitized) return "";

      const firstChar = sanitized.charAt(0);
      const hasValidPrefix = rifLetters.includes(firstChar);
      const letter = hasValidPrefix ? firstChar : "J";
      const numericPart = (hasValidPrefix ? sanitized.slice(1) : sanitized).replace(/\D/g, "").slice(0, 9);

      const main = numericPart.slice(0, 8);
      const verifier = numericPart.slice(8, 9);

      let masked = letter;
      if (main.length) masked += `-${main}`;
      if (verifier.length) masked += `-${verifier}`;

      return masked;
    };

    const applyCedulaMask = (rawValue) => {
      const sanitized = String(rawValue || "").toUpperCase().replace(/[^A-Z0-9]/g, "");
      if (!sanitized) return "";

      const firstChar = sanitized.charAt(0);
      const hasValidPrefix = cedulaLetters.includes(firstChar);
      const letter = hasValidPrefix ? firstChar : "V";
      const numericPart = (hasValidPrefix ? sanitized.slice(1) : sanitized).replace(/\D/g, "").slice(0, 8);

      let masked = letter;
      if (numericPart.length) masked += `-${numericPart}`;

      return masked;
    };

    const syncDocumentNumberBehavior = () => {
      const rifSelected = personSelect.value === "Juridica" && documentSelect.value === "RIF";
      const cedulaSelected = personSelect.value === "Natural" && documentSelect.value === "Cedula";

      if (rifSelected) {
        documentNumberInput.placeholder = "J-12345678-9";
        documentNumberInput.maxLength = 12;
        documentNumberInput.setAttribute("pattern", "[JGVEP]-[0-9]{8}-[0-9]{1}");
        documentNumberInput.setAttribute("title", "Formato RIF: J-12345678-9");
        documentNumberInput.value = applyRifMask(documentNumberInput.value);
      } else if (cedulaSelected) {
        documentNumberInput.placeholder = "V-12345678";
        documentNumberInput.maxLength = 10;
        documentNumberInput.setAttribute("pattern", "[VE]-[0-9]{6,8}");
        documentNumberInput.setAttribute("title", "Formato cédula: V-12345678 o E-12345678");
        documentNumberInput.value = applyCedulaMask(documentNumberInput.value);
      } else {
        documentNumberInput.placeholder = "Numero de documento";
        documentNumberInput.maxLength = 30;
        documentNumberInput.removeAttribute("pattern");
        documentNumberInput.removeAttribute("title");
      }
    };

    const rebuildDocumentOptions = () => {
      const selectedPerson = personSelect.value;
      const allowedOptions = optionsByPerson[selectedPerson] || [];
      const previousValue = documentSelect.value;

      documentSelect.innerHTML = "";

      const promptOption = document.createElement("option");
      promptOption.value = "";
      promptOption.textContent = "Selecciona";
      documentSelect.appendChild(promptOption);

      allowedOptions.forEach((optionValue) => {
        const option = document.createElement("option");
        option.value = optionValue;
        option.textContent = optionValue;
        documentSelect.appendChild(option);
      });

      if (allowedOptions.includes(previousValue)) {
        documentSelect.value = previousValue;
      } else {
        documentSelect.value = "";
      }

      syncDocumentNumberBehavior();
    };

    personSelect.addEventListener("change", rebuildDocumentOptions);
    documentSelect.addEventListener("change", syncDocumentNumberBehavior);
    documentNumberInput.addEventListener("input", () => {
      const rifSelected = personSelect.value === "Juridica" && documentSelect.value === "RIF";
      const cedulaSelected = personSelect.value === "Natural" && documentSelect.value === "Cedula";

      if (rifSelected) {
        documentNumberInput.value = applyRifMask(documentNumberInput.value);
        return;
      }

      if (cedulaSelected) {
        documentNumberInput.value = applyCedulaMask(documentNumberInput.value);
      }
    });

    rebuildDocumentOptions();
  })();
</script>
