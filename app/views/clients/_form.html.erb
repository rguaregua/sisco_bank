<section class="rounded-3xl border border-slate-200/80 bg-white/90 p-5 shadow-lg shadow-slate-300/20 backdrop-blur md:p-6">
  <% if client.errors.any? %>
    <div class="mb-5 rounded-2xl border border-rose-200 bg-rose-50 px-4 py-3 text-rose-800">
      <h3 class="text-sm font-extrabold uppercase tracking-wide">No se pudo guardar el cliente</h3>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
        <% client.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: client, local: true do |f| %>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
      <div>
        <%= f.label :type_of_person, "Tipo de persona", class: "text-sm font-semibold text-slate-700" %>
        <%= f.select :type_of_person,
          options_for_select(Client::PERSON_TYPES, client.type_of_person),
          { prompt: "Selecciona" },
          class: "mt-1 w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-200", required: true %>
      </div>

      <div>
        <%= f.label :type_of_document, "Tipo de documento", class: "text-sm font-semibold text-slate-700" %>
        <%= f.select :type_of_document,
          options_for_select(Client::DOC_TYPES, client.type_of_document),
          { prompt: "Selecciona" },
          class: "mt-1 w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-200", required: true %>
      </div>

      <div>
        <%= f.label :document_number, "Numero de documento", class: "text-sm font-semibold text-slate-700" %>
        <%= f.text_field :document_number, class: "mt-1 w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-200", required: true %>
      </div>

      <div>
        <%= f.label :full_name, "Nombre completo o razón social", class: "text-sm font-semibold text-slate-700" %>
        <%= f.text_field :full_name, class: "mt-1 w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-200", required: true, pattern: "[A-Za-zÁÉÍÓÚáéíóúÑñ ]+", title: "Solo letras y espacios" %>
      </div>

      <div>
        <%= f.label :email, "Correo", class: "text-sm font-semibold text-slate-700" %>
        <%= f.email_field :email, class: "mt-1 w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-200", required: true %>
      </div>

      <div>
        <%= f.label :primary_phone, "Telefono principal", class: "text-sm font-semibold text-slate-700" %>
        <%= f.text_field :primary_phone, class: "mt-1 w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-200", required: true, placeholder: "0XXXXXXXXXX", inputmode: "numeric", minlength: 11, maxlength: 11, pattern: "0[0-9]{10}", title: "Debe tener 11 digitos e iniciar con 0" %>
      </div>

      <div>
        <%= f.label :secondary_phone, "Telefono secundario", class: "text-sm font-semibold text-slate-700" %>
        <%= f.text_field :secondary_phone, class: "mt-1 w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-200", placeholder: "0XXXXXXXXXX", inputmode: "numeric", minlength: 11, maxlength: 11, pattern: "0[0-9]{10}", title: "Debe tener 11 digitos e iniciar con 0" %>
      </div>

      <div>
        <%= f.label :document_issued_at, "Fecha emision", class: "text-sm font-semibold text-slate-700" %>
        <%= f.date_field :document_issued_at, value: @document_issued_at_input, class: "mt-1 w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-200", required: true %>
      </div>

      <div>
        <%= f.label :document_expires_at, "Fecha vencimiento", class: "text-sm font-semibold text-slate-700" %>
        <%= f.date_field :document_expires_at, value: @document_expires_at_input, class: "mt-1 w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-200", required: true %>
      </div>
    </div>

    <% submit_label = client.persisted? ? "Guardar cambios" : "Crear cliente" %>

    <div class="mt-5 flex flex-wrap items-center gap-2">
      <%= f.submit submit_label, class: "inline-flex items-center gap-2 rounded-xl bg-blue-700 px-4 py-2 text-sm font-semibold text-white transition hover:bg-blue-800 focus:outline-none focus:ring-2 focus:ring-blue-400" %>
      <%= link_to "Cancelar", clients_path, class: "inline-flex items-center gap-2 rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-slate-300" %>
    </div>
  <% end %>
</section>
