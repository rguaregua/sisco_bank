<section class="card">
  <h2>Clientes</h2>
  <p class="muted">Busca, filtra y administra el registro de clientes.</p>

  <%= form_with url: clients_path, method: :get, local: true do %>
    <div class="filters-grid">
      <div>
        <label>Nombre</label>
        <%= text_field_tag :name, params[:name], class: "input" %>
      </div>
      <div>
        <label>Documento</label>
        <%= text_field_tag :document, params[:document], class: "input" %>
      </div>
      <div>
        <label>Tipo de persona</label>
        <%= select_tag :type_of_person,
          options_for_select([["Todos", ""], ["Natural", "Natural"], ["Juridica", "Juridica"]], params[:type_of_person]),
          class: "input" %>
      </div>
      <div>
        <label>Por pagina</label>
        <%= select_tag :per_page,
          options_for_select([["10", "10"], ["20", "20"], ["50", "50"]], params[:per_page] || "10"),
          class: "input" %>
      </div>
    </div>

    <div class="actions-row actions-row--right u-mt-sm">
      <%= button_tag type: :submit, class: "btn btn-primary btn-icon", title: "Aplicar filtros", aria: { label: "Aplicar filtros" } do %>
        <i class="bi bi-funnel" aria-hidden="true"></i>
        <span class="btn-label">Filtrar</span>
      <% end %>
      <%= link_to clients_path, class: "btn btn-soft btn-icon", title: "Limpiar filtros", aria: { label: "Limpiar filtros" } do %>
        <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
        <span class="btn-label">Limpiar</span>
      <% end %>
    </div>
  <% end %>
</section>

<section class="card">
  <div class="table-wrap">
    <table class="clients-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>Nombre</th>
          <th>Documento</th>
          <th>Email</th>
          <th>Telefono</th>
          <th>Creado</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% @clients.each do |client| %>
          <tr>
            <td><%= client.id %></td>
            <td><%= client.full_name %></td>
            <td><%= client.type_of_document %> <%= client.document_number %></td>
            <td><%= client.email %></td>
            <td><%= client.primary_phone %></td>
            <td><%= l(client.created_at.to_date) %></td>
            <td>
              <div class="actions-row actions-row--compact">
                <%= link_to client_path(client), class: "btn btn-soft btn-icon", title: "Ver cliente", aria: { label: "Ver cliente" } do %>
                  <i class="bi bi-eye" aria-hidden="true"></i>
                  <span class="btn-label">Ver</span>
                <% end %>
                <%= link_to "#{client_path(client)}/edit", class: "btn btn-soft btn-icon", title: "Editar cliente", aria: { label: "Editar cliente" } do %>
                  <i class="bi bi-pencil-square" aria-hidden="true"></i>
                  <span class="btn-label">Editar</span>
                <% end %>
                <%= button_to client_path(client), method: :delete, data: { turbo_confirm: "Deseas eliminar este cliente?" }, class: "btn btn-danger btn-icon", title: "Eliminar cliente", aria: { label: "Eliminar cliente" } do %>
                  <i class="bi bi-trash" aria-hidden="true"></i>
                  <span class="btn-label">Eliminar</span>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="cards-mobile">
    <% @clients.each do |client| %>
      <article class="mobile-card">
        <h3><%= client.full_name %></h3>
        <p><strong>Documento:</strong> <%= client.type_of_document %> <%= client.document_number %></p>
        <p><strong>Email:</strong> <%= client.email %></p>
        <p><strong>Telefono:</strong> <%= client.primary_phone %></p>
        <div class="actions-row">
          <%= link_to client_path(client), class: "btn btn-soft btn-icon", title: "Ver cliente", aria: { label: "Ver cliente" } do %>
            <i class="bi bi-eye" aria-hidden="true"></i>
            <span class="btn-label">Ver</span>
          <% end %>
          <%= link_to "#{client_path(client)}/edit", class: "btn btn-soft btn-icon", title: "Editar cliente", aria: { label: "Editar cliente" } do %>
            <i class="bi bi-pencil-square" aria-hidden="true"></i>
            <span class="btn-label">Editar</span>
          <% end %>
          <%= button_to client_path(client), method: :delete, data: { turbo_confirm: "Deseas eliminar este cliente?" }, class: "btn btn-danger btn-icon", title: "Eliminar cliente", aria: { label: "Eliminar cliente" } do %>
            <i class="bi bi-trash" aria-hidden="true"></i>
            <span class="btn-label">Eliminar</span>
          <% end %>
        </div>
      </article>
    <% end %>
  </div>

  <% total_pages = @clients.total_pages %>
  <% current_page = @clients.current_page %>
  <% visible_window = 1 %>
  <% middle_pages = ((current_page - visible_window)..(current_page + visible_window)).to_a.select { |page| page.between?(1, total_pages) } %>
  <% page_items = [1, *middle_pages, total_pages].uniq.sort %>

  <div class="pagination-row">
    <p class="pagination-meta muted">
      Pagina <strong><%= current_page %></strong> de <strong><%= total_pages %></strong>
    </p>

    <% if total_pages > 1 %>
      <nav class="pagination-nav" aria-label="Paginacion de clientes">
        <% if @clients.prev_page %>
          <%= link_to clients_path(request.query_parameters.merge(page: 1)), class: "pagination-chip", title: "Primera pagina", aria: { label: "Primera pagina" } do %>
            <i class="bi bi-chevron-double-left" aria-hidden="true"></i>
          <% end %>
          <%= link_to clients_path(request.query_parameters.merge(page: @clients.prev_page)), class: "pagination-chip", title: "Pagina anterior", aria: { label: "Pagina anterior" } do %>
            <i class="bi bi-chevron-left" aria-hidden="true"></i>
          <% end %>
        <% else %>
          <span class="pagination-chip is-disabled" aria-hidden="true"><i class="bi bi-chevron-double-left"></i></span>
          <span class="pagination-chip is-disabled" aria-hidden="true"><i class="bi bi-chevron-left"></i></span>
        <% end %>

        <% page_items.each_with_index do |page, index| %>
          <% previous_page = index.zero? ? nil : page_items[index - 1] %>
          <% if previous_page && page - previous_page > 1 %>
            <span class="pagination-ellipsis" aria-hidden="true">…</span>
          <% end %>

          <% if page == current_page %>
            <span class="pagination-chip is-current" aria-current="page"><%= page %></span>
          <% else %>
            <%= link_to page, clients_path(request.query_parameters.merge(page: page)), class: "pagination-chip", aria: { label: "Ir a pagina #{page}" } %>
          <% end %>
        <% end %>

        <% if @clients.next_page %>
          <%= link_to clients_path(request.query_parameters.merge(page: @clients.next_page)), class: "pagination-chip", title: "Pagina siguiente", aria: { label: "Pagina siguiente" } do %>
            <i class="bi bi-chevron-right" aria-hidden="true"></i>
          <% end %>
          <%= link_to clients_path(request.query_parameters.merge(page: total_pages)), class: "pagination-chip", title: "Ultima pagina", aria: { label: "Ultima pagina" } do %>
            <i class="bi bi-chevron-double-right" aria-hidden="true"></i>
          <% end %>
        <% else %>
          <span class="pagination-chip is-disabled" aria-hidden="true"><i class="bi bi-chevron-right"></i></span>
          <span class="pagination-chip is-disabled" aria-hidden="true"><i class="bi bi-chevron-double-right"></i></span>
        <% end %>
      </nav>
    <% end %>
  </div>
</section>
