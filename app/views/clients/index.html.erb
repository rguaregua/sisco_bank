<section class="relative overflow-hidden rounded-3xl border border-slate-200 bg-white/90 p-4 shadow-lg shadow-slate-300/20 backdrop-blur md:p-5">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-16 bg-linear-to-r from-sky-100/70 via-cyan-50/60 to-emerald-100/70"></div>

  <% active_filters = [:name, :document, :type_of_person].count { |key| params[key].present? } %>
  <% input_classes = "h-9 w-full rounded-lg border border-slate-300 bg-white py-1.5 pl-8 pr-2 text-xs text-slate-800 outline-none transition focus:border-cyan-500 focus:ring-2 focus:ring-cyan-100" %>
  <% text_filters = [
    { key: :name, label: "Nombre", icon: "bi-person", placeholder: "Nombre" },
    { key: :document, label: "Doc", icon: "bi-card-text", placeholder: "Documento" }
  ] %>
  <% select_filters = [
    { key: :type_of_person, label: "Persona", icon: "bi-people", options: [["Persona", ""], ["Natural", "Natural"], ["Juridica", "Juridica"]], selected: params[:type_of_person] },
    { key: :per_page, label: "Pag", icon: "bi-list-ol", options: [["10", "10"], ["20", "20"], ["50", "50"]], selected: params[:per_page] || "10" }
  ] %>
  <% modal_payload_for = lambda do |client|
      {
        id: client.id,
        full_name: client.full_name,
        type_of_person: client.type_of_person,
        type_of_document: client.type_of_document,
        document_number: client.document_number,
        document_issued_at: client.document_issued_at&.strftime("%d-%m-%Y").presence || "-",
        document_expires_at: client.document_expires_at&.strftime("%d-%m-%Y").presence || "-",
        email: client.email,
        primary_phone: client.primary_phone,
        secondary_phone: client.secondary_phone.presence || "-",
        created_at: l(client.created_at),
        edit_path: edit_client_path(client)
      }.to_json
    end %>

  <div class="relative flex flex-wrap items-center justify-between gap-2">
    <div>
      <h2 class="text-lg font-extrabold tracking-tight text-slate-900 md:text-xl">Clientes</h2>
      <p class="mt-0.5 text-xs text-slate-500">Busca, filtra y administra el registro de clientes.</p>
    </div>
    <span class="inline-flex items-center gap-1.5 rounded-full border border-cyan-200 bg-white/90 px-2.5 py-1 text-[11px] font-bold uppercase tracking-wide text-cyan-700 shadow-sm">
      <i class="bi bi-sliders2" aria-hidden="true"></i>
      <%= active_filters %> activos
    </span>
  </div>

  <%= form_with url: clients_path, method: :get, local: true, class: "relative mt-3" do %>
    <div class="flex w-full flex-wrap items-center gap-2 lg:flex-nowrap">
      <% text_filters.each do |filter| %>
        <div class="relative min-w-[8.5rem] flex-1">
          <label class="sr-only" for="filter_<%= filter[:key] %>"><%= filter[:label] %></label>
          <i class="bi <%= filter[:icon] %> pointer-events-none absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-400" aria-hidden="true"></i>
          <%= text_field_tag filter[:key], params[filter[:key]], id: "filter_#{filter[:key]}", placeholder: filter[:placeholder], class: input_classes %>
        </div>
      <% end %>

      <% select_filters.each do |filter| %>
        <div class="relative min-w-[7.5rem] flex-1">
          <label class="sr-only" for="filter_<%= filter[:key] %>"><%= filter[:label] %></label>
          <i class="bi <%= filter[:icon] %> pointer-events-none absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-400" aria-hidden="true"></i>
          <%= select_tag filter[:key], options_for_select(filter[:options], filter[:selected]), id: "filter_#{filter[:key]}", class: input_classes %>
        </div>
      <% end %>

      <%= link_to clients_path, class: "inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-slate-300 bg-white text-slate-700 transition hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-slate-300", title: "Limpiar filtros", aria: { label: "Limpiar filtros" } do %>
        <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
        <span class="sr-only">Limpiar</span>
      <% end %>
      <%= button_tag type: :submit, class: "inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-gradient-to-r from-cyan-600 to-blue-700 text-white shadow-sm transition hover:from-cyan-700 hover:to-blue-800 focus:outline-none focus:ring-2 focus:ring-cyan-400", title: "Aplicar filtros", aria: { label: "Aplicar filtros" } do %>
        <i class="bi bi-funnel" aria-hidden="true"></i>
        <span class="sr-only">Filtrar</span>
      <% end %>
    </div>
  <% end %>
</section>

<section class="rounded-3xl border border-slate-200/80 bg-white/90 p-5 shadow-lg shadow-slate-300/20 backdrop-blur md:p-6">
  <div class="hidden overflow-x-auto lg:block">
    <table class="min-w-full border-separate border-spacing-y-1 text-left text-sm">
      <thead>
        <tr class="text-xs uppercase tracking-wide text-slate-900">
          <th class="px-3 py-2">ID</th>
          <th class="px-3 py-2">Nombre</th>
          <th class="px-3 py-2">Documento</th>
          <th class="px-3 py-2">Email</th>
          <th class="px-3 py-2">Telefono</th>
          <th class="px-3 py-2">Creado</th>
          <th class="px-3 py-2">Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% @clients.each do |client| %>
          <tr class="rounded-2xl bg-slate-50 text-slate-700 transition hover:bg-slate-100">
            <td class="px-3 py-3 font-semibold text-slate-900"><%= client.id %></td>
            <td class="px-3 py-3"><%= client.full_name %></td>
            <td class="px-3 py-3"><%= client.type_of_document %> <%= client.document_number %></td>
            <td class="px-3 py-3"><%= client.email %></td>
            <td class="px-3 py-3"><%= client.primary_phone %></td>
            <td class="px-3 py-3"><%= l(client.created_at.to_date) %></td>
            <td class="px-3 py-3">
              <div class="flex items-center gap-2">
                <%= link_to "#",
                  class: "inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-300 bg-white text-slate-600 transition hover:bg-slate-100",
                  title: "Ver cliente",
                  aria: { label: "Ver cliente" },
                  data: { client_modal_trigger: true, client_modal_payload: modal_payload_for.call(client) } do %>
                  <i class="bi bi-eye" aria-hidden="true"></i>
                  <span class="sr-only">Ver</span>
                <% end %>
                <%= link_to edit_client_path(client), class: "inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-300 bg-white text-slate-600 transition hover:bg-slate-100", title: "Editar cliente", aria: { label: "Editar cliente" } do %>
                  <i class="bi bi-pencil-square" aria-hidden="true"></i>
                  <span class="sr-only">Editar</span>
                <% end %>
                <%= button_to client_path(client), method: :delete, data: { turbo_confirm: "Deseas eliminar este cliente?" }, class: "inline-flex h-9 w-9 items-center justify-center rounded-lg border border-rose-300 bg-rose-50 text-rose-700 transition hover:bg-rose-100", title: "Eliminar cliente", aria: { label: "Eliminar cliente" } do %>
                  <i class="bi bi-trash" aria-hidden="true"></i>
                  <span class="sr-only">Eliminar</span>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <dialog id="client-modal" class="m-auto w-[min(52rem,96vw)] rounded-3xl border border-slate-200 bg-transparent p-0 text-left text-slate-800 shadow-2xl backdrop:bg-slate-900/50 backdrop:backdrop-blur-sm">
    <article class="rounded-3xl bg-white p-4 md:p-6">
      <div class="flex items-start justify-between gap-3 border-b border-slate-200 pb-3">
        <div>
          <h3 id="client-modal-title" class="text-lg font-extrabold text-slate-900 md:text-xl">Detalle del cliente</h3>
          <p id="client-modal-subtitle" class="text-xs text-slate-500">Visualizacion rapida sin salir del listado</p>
        </div>
        <form method="dialog">
          <button type="submit" class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-300 bg-white text-slate-600 transition hover:bg-slate-100" aria-label="Cerrar detalle de cliente">
            <i class="bi bi-x-lg" aria-hidden="true"></i>
          </button>
        </form>
      </div>

      <div id="client-modal-content" class="mt-4 grid grid-cols-1 gap-2 text-sm text-slate-700 md:grid-cols-2"></div>

      <div class="mt-4 flex flex-wrap items-center justify-end gap-2 border-t border-slate-200 pt-3">
        <a id="modal-client-edit-link" href="#" class="inline-flex items-center gap-2 rounded-lg bg-blue-700 px-3 py-2 text-sm font-semibold text-white transition hover:bg-blue-800">
          <i class="bi bi-pencil-square" aria-hidden="true"></i>
          <span>Editar</span>
        </a>
      </div>
    </article>
  </dialog>

  <% total_pages = @clients.total_pages %>
  <% current_page = @clients.current_page %>
  <% visible_window = 1 %>
  <% middle_pages = ((current_page - visible_window)..(current_page + visible_window)).to_a.select { |page| page.between?(1, total_pages) } %>
  <% page_items = [1, *middle_pages, total_pages].uniq.sort %>

  <div class="mt-5 flex flex-wrap items-center justify-center gap-3 border-t border-slate-200 pt-4">
    <% if total_pages > 1 %>
      <nav class="inline-flex flex-wrap items-center gap-1 rounded-2xl border border-slate-200 bg-slate-50 p-1.5" aria-label="Paginacion de clientes">
        <% if @clients.prev_page %>
          <%= link_to clients_path(request.query_parameters.merge(page: 1)), class: "inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-600 transition hover:bg-slate-100", title: "Primera pagina", aria: { label: "Primera pagina" } do %>
            <i class="bi bi-chevron-double-left" aria-hidden="true"></i>
          <% end %>
          <%= link_to clients_path(request.query_parameters.merge(page: @clients.prev_page)), class: "inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-600 transition hover:bg-slate-100", title: "Pagina anterior", aria: { label: "Pagina anterior" } do %>
            <i class="bi bi-chevron-left" aria-hidden="true"></i>
          <% end %>
        <% else %>
          <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-slate-100 text-slate-300" aria-hidden="true"><i class="bi bi-chevron-double-left"></i></span>
          <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-slate-100 text-slate-300" aria-hidden="true"><i class="bi bi-chevron-left"></i></span>
        <% end %>

        <% page_items.each_with_index do |page, index| %>
          <% previous_page = index.zero? ? nil : page_items[index - 1] %>
          <% if previous_page && page - previous_page > 1 %>
            <span class="px-1 text-slate-400" aria-hidden="true">...</span>
          <% end %>

          <% if page == current_page %>
            <span class="inline-flex h-9 min-w-9 items-center justify-center rounded-lg bg-blue-700 px-2 text-sm font-bold text-white shadow" aria-current="page"><%= page %></span>
          <% else %>
            <%= link_to page, clients_path(request.query_parameters.merge(page: page)), class: "inline-flex h-9 min-w-9 items-center justify-center rounded-lg border border-slate-200 bg-white px-2 text-sm font-semibold text-slate-600 transition hover:bg-slate-100", aria: { label: "Ir a pagina #{page}" } %>
          <% end %>
        <% end %>

        <% if @clients.next_page %>
          <%= link_to clients_path(request.query_parameters.merge(page: @clients.next_page)), class: "inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-600 transition hover:bg-slate-100", title: "Pagina siguiente", aria: { label: "Pagina siguiente" } do %>
            <i class="bi bi-chevron-right" aria-hidden="true"></i>
          <% end %>
          <%= link_to clients_path(request.query_parameters.merge(page: total_pages)), class: "inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-600 transition hover:bg-slate-100", title: "Ultima pagina", aria: { label: "Ultima pagina" } do %>
            <i class="bi bi-chevron-double-right" aria-hidden="true"></i>
          <% end %>
        <% else %>
          <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-slate-100 text-slate-300" aria-hidden="true"><i class="bi bi-chevron-right"></i></span>
          <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-slate-100 text-slate-300" aria-hidden="true"><i class="bi bi-chevron-double-right"></i></span>
        <% end %>
      </nav>
    <% end %>
  </div>
</section>

