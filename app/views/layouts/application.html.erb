<!DOCTYPE html>
<html>
  <head>
    <title>Sisco Bank | Clientes</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <%= stylesheet_link_tag "base", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "components", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "clients", "data-turbo-track": "reload" %>
  </head>

  <body>
    <div class="shell">
      <header class="topbar">
        <h1>Sisco Bank</h1>
        <p>Gestion de clientes</p>
        <div class="actions-row">
          <%= link_to "Listado", clients_path, class: "btn btn-soft" %>
          <%= link_to "Nuevo cliente", new_client_path, class: "btn btn-primary" %>
        </div>
      </header>

      <% flash.each do |type, message| %>
        <div class="flash <%= type %>"><%= message %></div>
      <% end %>

      <main class="stack">
        <%= yield %>
      </main>
    </div>
  </body>
</html>
