<!DOCTYPE html>
<html>
  <head>
    <title>Sisco Bank | Clientes</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              sans: ["Manrope", "ui-sans-serif", "system-ui", "sans-serif"]
            }
          }
        }
      };
    </script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <%= javascript_include_tag "clients_modal.js", defer: true %>
  </head>

  <body class="min-h-screen bg-slate-100 font-sans text-slate-800">
    <div class="mx-auto max-w-6xl px-4 py-6 md:px-6 md:py-10">
      <header class="mb-6 rounded-3xl bg-blue-900 p-6 text-white shadow-lg md:p-7">
        <h1 class="text-2xl font-extrabold md:text-3xl">Sisco Bank</h1>
        <p class="mt-2 text-sm text-blue-100 md:text-base">Gestion de clientes</p>
        <div class="mt-4 flex flex-wrap gap-2">
          <%= link_to clients_path, class: "inline-flex items-center gap-2 rounded-xl border border-blue-100/30 bg-blue-400 px-4 py-2 text-sm font-semibold text-slate-900 hover:bg-blue-700" do %>
            <i class="bi bi-list-ul" aria-hidden="true"></i>
            <span>Listado</span>
          <% end %>
          <%= link_to new_client_path, class: "inline-flex items-center gap-2 rounded-xl bg-cyan-300 px-4 py-2 text-sm font-semibold text-slate-900 hover:bg-cyan-200" do %>
            <i class="bi bi-plus-circle" aria-hidden="true"></i>
            <span>Nuevo cliente</span>
          <% end %>
        </div>
      </header>

      <% flash.each do |type, message| %>
        <% flash_class = type.to_s == "notice" ? "border-emerald-200 bg-emerald-50 text-emerald-800" : "border-rose-200 bg-rose-50 text-rose-800" %>
        <div class="mb-4 rounded-xl border px-4 py-3 text-sm font-semibold <%= flash_class %>"><%= message %></div>
      <% end %>

      <main class="space-y-4 md:space-y-5">
        <%= yield %>
      </main>
    </div>
  </body>
</html>
